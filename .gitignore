# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
*.dll
*.exe

# C++ Build artifacts
build/
*.obj
*.o
*.a
*.lib

# Data files & intermediate storage
data/raw/
data/parsed/
data/enriched/
data/clob_snapshots/
data/clob_books/
data/results_pre_nsetick_*/
data/spark_tmp/
data/results/*.csv
data/results/*.png
data/results/*.pdf
# Generated alongside the manuscript on every run; the manuscript .tex is
# tracked so the paper's wording is reviewable, but its inputs are not.
data/results/metrics.json
# The manuscript source under paper/ is tracked; everything the pipeline writes into it is
# regenerated on each run.
paper/generated/
paper/figures/
paper/*.pdf
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc

# Keep results directory structure
!data/results/.gitkeep
!data/raw/.gitkeep
!data/bloomberg/.gitkeep

# IDEs & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
scratch/
logs/
*.aux
*.log
*.out

# Built by scripts/paper_bundle.py; regenerate it rather than committing it.
paper_bundle*.tar.gz
